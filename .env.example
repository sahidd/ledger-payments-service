# Local development overrides. Copy to .env if you want them picked up by your shell.
# Never commit a real .env. Docker Compose starts without this file.

# PostgreSQL. Compose defaults match these values.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ledger
SPRING_DATASOURCE_USERNAME=ledger
SPRING_DATASOURCE_PASSWORD=ledger

# Host process uses the external listener. The app container uses kafka:19092.
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Jaeger OTLP HTTP. Leave unset to keep the application.yml default.
MANAGEMENT_OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces

# AI is off unless you opt in. Any OpenAI-compatible base URL works.
# When you set a key, also switch the chat model on. The app starts and the
# risk endpoint keeps working when these are absent.
# SPRING_AI_MODEL_CHAT=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini
